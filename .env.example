# 必填：控制台管理员（单用户；首次启动建号后改口令请走数据库）
# 勿将真实口令提交进仓库；复制为本目录 .env 后修改。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 可选：代理（Docker / 本地均可；例 socks5://127.0.0.1:1080 或 http://…）
# PROXY=

# Telegram API（可选；不填则启动时自动用 Desktop 公开凭证 2040）
TG_APP_ID=
TG_APP_HASH=

# 可选（本地开发覆盖；Docker 镜像已内置 BIND/WEB_DIR/CONFIG_PATH）
BIND=0.0.0.0:3000
WEB_DIR=./web/dist
CONFIG_PATH=./config/config.yaml
# JWT_SECRET=
